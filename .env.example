# ============================================================================
# KINOO — variables d'environnement
# Ne JAMAIS committer de vraies valeurs. Générez les secrets avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=production
# Cloud Run injecte PORT automatiquement (3000 par défaut en local)
PORT=3000
# URL publique canonique (utilisée dans les e-mails, les redirections OAuth, le .ics). OBLIGATOIRE en production.
PUBLIC_BASE_URL=https://kinoo.app
APP_URL=
# Origines supplémentaires autorisées pour CORS / WebSocket (séparées par des virgules)
ALLOWED_ORIGINS=
# Sources supplémentaires pour la CSP connect-src (séparées par des espaces), ex. https://api.exemple.com
CSP_EXTRA_CONNECT_SRC=

# --- Base de données PostgreSQL (une des deux options) ----------------------
DATABASE_URL=
# ou Cloud SQL :
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
# Compte administrateur SQL (migrations de schéma uniquement, optionnel)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_SSL=
# TLS vers la base : vérification ACTIVÉE par défaut. Ne passer à false qu'en connaissance de cause.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=true
# Certificat CA du fournisseur (PEM, retours à la ligne écrits \n). Requis par Supabase si la vérification TLS est active.
DB_SSL_CA=

# --- Secrets (OBLIGATOIRES en production, 32 caractères minimum chacun) -----
JWT_SECRET=
OAUTH_STATE_SECRET=
MODERATION_HMAC_SECRET=
# Secret partagé avec Cloud Scheduler pour la purge des archives de modération (16+ caractères)
INTERNAL_CRON_SECRET=

# --- Compte Super Admin (OBLIGATOIRES : plus aucun mot de passe par défaut) --
ADMIN_EMAIL=
# Mot de passe initial (10+ caractères, 1 majuscule, 1 chiffre). Utilisé uniquement à la création du compte.
ADMIN_INITIAL_PASSWORD=
# Adresse qui reçoit les liens de déblocage d'urgence (par défaut : ADMIN_EMAIL)
SUPER_ADMIN_UNLOCK_EMAIL=

# --- Connexion Google ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Identifiants clients Google autorisés pour le jeton d'identité (séparés par des virgules ; défaut : GOOGLE_CLIENT_ID)
GOOGLE_ALLOWED_AUDIENCES=

# --- Anti-bot (Cloudflare Turnstile) -----------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Limitation de débit -----------------------------------------------------
RATE_LIMIT_IP_MAX_ATTEMPTS=45

# --- Mode prévisualisation AI Studio (À NE PAS ACTIVER EN PRODUCTION) ---------
# Renvoie le jeton de session dans le corps JSON et passe les cookies en SameSite=None.
IS_AI_STUDIO_PREVIEW=false
ALLOW_BEARER_FALLBACK=false

# --- WebRTC (STUN / TURN) ------------------------------------------------------
# Sans serveur TURN, les participants derrière un NAT symétrique ne pourront pas se connecter en vocal.
STUN_SERVER_URL=stun:stun.l.google.com:19302
# Option A (Coturn avec secret éphémère HMAC-SHA1) :
TURN_SERVER_URL=
TURN_SECRET=
# Option B (identifiants statiques, ex. Twilio / Metered) :
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Monitoring Sentry ---------------------------------------------------------
VITE_SENTRY_DSN=
SENTRY_DSN=

# --- E-mails transactionnels (Resend ou Brevo) ---------------------------------
# Sans clé, les e-mails sont simulés (aucun envoi réel).
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=Kinoo <notifications@kinoo.app>

# --- Autres --------------------------------------------------------------------
GEMINI_API_KEY=
